<div class="owen-blog-directory">
  <div class="owen-blog-heading">
    <h1>时间线</h1>
    <span>按最初写下的时间归档。</span>
  </div>
  {% set groups = collections.owenBlogPosts | owenBlogTimeline %}
  {% if groups.length %}
    <div class="owen-timeline">
      {% for year in groups %}
        <section aria-labelledby="year-{{ year.year }}">
          <h2 id="year-{{ year.year }}">{{ year.year }}</h2>
          {% for month in year.months %}
            <div class="owen-timeline-month">
              <h3>{{ month.monthLabel }}</h3>
              <ol>
                {% for post in month.posts %}
                  <li>
                    <a href="{{ post.url }}">{{ post.data.title or post.fileSlug }}</a>
                    <time>{{ post | owenBlogDate }}</time>
                  </li>
                {% endfor %}
              </ol>
            </div>
          {% endfor %}
        </section>
      {% endfor %}
    </div>
  {% else %}
    <div class="owen-blog-empty"><p>时间线里还没有文章。</p></div>
  {% endif %}
</div>

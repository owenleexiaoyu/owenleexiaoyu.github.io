      <section class="section section--tint" id="blog" aria-labelledby="blog-heading">
        <div class="wrap">
          <header class="section-head reveal" data-reveal>
            <p class="section-eyebrow">{{ home.blog.eyebrow }}</p>
            <h2 id="blog-heading" class="section-title">{{ home.blog.title }}</h2>
            <p class="section-lead">{{ home.blog.lead }}</p>
            <span class="section-glowline" aria-hidden="true"></span>
          </header>
          <div class="callout glass-panel callout--motion reveal" data-reveal data-reveal-delay="60">
            <div class="callout__aurora" aria-hidden="true"></div>
            <p class="callout__text">{{ home.blog.callout }}</p>
            <a class="btn btn--glow" href="{{ home.blog.cta.href }}" target="_blank" rel="noreferrer">{{ home.blog.cta.label }}</a>
          </div>
        </div>
      </section>

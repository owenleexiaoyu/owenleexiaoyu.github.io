      <section class="hero" id="top">
        <div class="hero__bg" aria-hidden="true">
          <canvas id="heroConstellation" class="constellation-canvas"></canvas>
          <div class="hero__veil"></div>
        </div>
        <div class="wrap hero__inner">
          <div class="hero__glass glass-panel">
            <p class="hero__wave hero-line">
              {{ home.hero.wave }} <span class="hero__emoji" aria-hidden="true">{{ home.hero.waveEmoji }}</span>
            </p>
            <h1 class="hero__name hero-line">
              <span class="hero__name-inner">{{ home.hero.nameHtml | safe }}</span>
            </h1>
            <p class="hero__en hero-line">{{ home.hero.en }}</p>
            <p class="hero__tag hero-line">{{ home.hero.tag }}</p>
            <div class="hero__actions hero-line" aria-label="操作与社交">
              <div class="hero__actions-primary">
                {% for a in home.hero.primaryActions %}
                  <a class="btn {% if loop.first %}btn--glow{% else %}btn--ghost{% endif %}" href="{{ a.href }}">{{ a.label }}</a>
                {% endfor %}
              </div>
              <div class="hero__actions-social">
                {% for s in home.hero.social %}
                  <a class="hero__link" href="{{ s.href }}" target="_blank" rel="noreferrer">
                    <img src="{{ s.icon }}" width="18" height="18" alt="" />
                    {{ s.label }}
                  </a>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </section>
